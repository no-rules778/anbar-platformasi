VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Localhost shares the PRODUCTION Supabase project, so a local write is a real
# production write. ALL reference writes (create / update / delete / deactivate
# / activate) are blocked on localhost unless this is exactly 'true'. Has no
# effect on a deployed build.
VITE_ALLOW_LOCAL_WRITES=false
